---
import '@fontsource-variable/jost';
import jostLatin from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../config.js';

interface Props {
  lang: 'es' | 'ca';
  title: string;
  description: string;
  path: string;
  alternates?: { es: string; ca: string };
  jsonld?: object[];
  noindex?: boolean;
}
const { lang, title, description, path, alternates, jsonld = [], noindex = false } = Astro.props;
const canonical = new URL(path, SITE.url).href;
const ogImage = new URL(lang === 'ca' ? '/og-ca.png' : '/og-es.png', SITE.url).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} · ${SITE.name}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {alternates && (
      <>
        <link rel="alternate" hreflang="es-ES" href={new URL(alternates.es, SITE.url).href} />
        <link rel="alternate" hreflang="ca-ES" href={new URL(alternates.ca, SITE.url).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(alternates.es, SITE.url).href} />
      </>
    )}
    <meta name="theme-color" content="#2a2a26" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151513" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={jostLatin} as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === 'ca' ? 'ca_ES' : 'es_ES'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}

    <script is:inline>document.documentElement.classList.add('js')</script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <slot />
  </body>
</html>
