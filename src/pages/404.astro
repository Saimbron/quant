---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { T, ROUTES } from '../lib/i18n.js';
import { withBase } from '../lib/paths.js';
const t = T.es.notFound;
const c = T.ca.notFound;
---
<Base lang="es" title={t.title} description={t.text} path="/404/" noindex>
  <section class="hero" style="min-height:100svh">
    <div class="wrap">
      <Header lang="es" />
      <div style="margin-top:clamp(56px,10vw,160px);display:grid;gap:28px;max-width:720px">
        <p class="display num" style="font-size:var(--step-display)">404</p>
        <h1 style="font-size:var(--step-lead);font-weight:500">{t.text}</h1>
        <p lang="ca" style="color:var(--night-muted)">{c.text}</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap">
          <a class="button" href={withBase(ROUTES.es.sueldo)}>{t.cta}</a>
          <a class="button" style="background:var(--night-2);color:var(--night-ink)" href={withBase(ROUTES.ca.sueldo)} lang="ca">{c.cta}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
